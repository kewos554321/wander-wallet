# Database (Required)
# 單一連線時用 .env 的 DATABASE_URL。
# 要區分 dev / main 兩個 DB 時，額外建立 `.env.dev` 與 `.env.main`（都已被 gitignore），各自放：
#   DATABASE_URL="postgresql://...@<dev-or-main-host>/neondb?sslmode=require"
# 然後用：
#   npm run dev:dev / dev:main            # 用對應 DB 起 dev server
#   npm run db:diff:dev / db:diff:main    # 唯讀：印出「該 DB → schema.prisma」的差異 SQL（不會套用）
#   npm run db:push:dev / db:push:main    # 套用 schema 到該 DB（會先列出變更再問你）
# ⚠️ 對 main 執行 db:push 前務必先備份（Neon branch / PITR），並先看 db:diff:main 的 SQL。
# ⚠️ 另外 dev:main 之前要確認 main 已同步 schema，否則舊 schema 讀到新欄位會出錯。
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth (Required) - Generate: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here"

# LINE LIFF (Optional) - https://developers.line.biz/console/
# NEXT_PUBLIC_LIFF_ID="your-liff-id"
# NEXT_PUBLIC_LIFF_URL="https://liff.line.me/your-liff-id"

# AI Services (Optional)
QWEN_API_KEY="your-qwen-api-key"          # https://dashscope.console.aliyun.com/apiKey
DEEPSEEK_API_KEY="your-deepseek-api-key"  # https://platform.deepseek.com/

# Cloudflare R2 Storage (Optional) - For image uploads
# Create bucket at: https://dash.cloudflare.com/ > R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-custom-domain.com"  # Public URL for R2 bucket

# Debug (Optional)
NEXT_PUBLIC_DEBUG_MODE="false"  # Set to "true" to show debug overlay on screen
